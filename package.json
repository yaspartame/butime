{
  "name": "butime",
  "productName": "butime",
  "version": "2.1.0",
  "description": "Offline time-management app",
  "main": "main.js",
  "author": "Miyakazine",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.meow.butime",
    "productName": "butime",
    "files": ["main.js", "front/**/*", "back/**/*", "build/tray.png", "build/icon.png"],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Miyakazine <yaspartame@users.noreply.github.com>",
      "synopsis": "Offline time-management app",
      "description": "Offline time-management app with Eisenhower matrix, calendar, pomodoro and desktop widgets."
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "butime",
      "runAfterFinish": true
    }
  }
}